# SpaceLoop Environment Variables Configuration

# Server
PORT=5001
FLASK_ENV=development
# Generate a cryptographically strong key for production (e.g. `python -c "import secrets; print(secrets.token_hex(32))"`)
SECRET_KEY=spaceloop_super_secret_hack2ignite_2026_key

# Authentication & Rate Limiting (Flask-Limiter)
AUTH_LOGIN_RATE_LIMIT="5 per minute"
AUTH_REGISTER_RATE_LIMIT="3 per hour"
AUTH_PASSWORD_RESET_RATE_LIMIT="3 per hour"
RATELIMIT_STORAGE_URI=memory://

# Auth Token Expirations (seconds)
PASSWORD_RESET_TOKEN_EXPIRY=3600
EMAIL_VERIFICATION_TOKEN_EXPIRY=86400

# Database
DATABASE_URL=sqlite:///spaceloop.db

# AI Engine Keys (Optional: deterministic heuristic fallback is active if omitted)
GROQ_API_KEY=
GEMINI_API_KEY=

# Security & Compliance
DPDP_SALT=spaceloop_dpdp_salt_v2_2026
AI_RATE_LIMIT=20
ESCROW_AMOUNT_INR=100.0
