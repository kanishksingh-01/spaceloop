# SpaceLoop Environment Configuration Template (.env.example)
# Copy this file to .env and configure your local or production keys.

# ==============================================================================
# 1. External AI Connectivity (Groq & Google Gemini)
# ==============================================================================
# Groq Cloud API Key (Get from https://console.groq.com)
GROQ_API_KEY=gsk_your_groq_api_key_here
GROQ_MODEL=openai/gpt-oss-120b
GROQ_FALLBACK_MODEL=openai/gpt-oss-20b

# Google Gemini API Key (Get from https://aistudio.google.com)
GEMINI_API_KEY=your_gemini_api_key_here
GOOGLE_API_KEY=

# ==============================================================================
# 2. Server & Security Configuration
# ==============================================================================
SECRET_KEY=generate_a_random_secure_secret_for_production
FLASK_ENV=development
FLASK_PORT=5000
DATABASE_URL=sqlite:///app.db

# Rate limits
AUTH_LOGIN_RATE_LIMIT=120 per minute
AUTH_REGISTER_RATE_LIMIT=120 per minute
AUTH_PASSWORD_RESET_RATE_LIMIT=60 per minute
AI_RATE_LIMIT=200 per minute

# Session & CSRF
WTF_CSRF_ENABLED=False
SESSION_COOKIE_SECURE=False

# CORS Origins (Comma-separated)
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000,http://localhost:5000,http://127.0.0.1:5000
