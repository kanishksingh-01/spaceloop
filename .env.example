# SpaceLoop Environment Configuration Template (.env.example)
# Copy this file to .env and configure your local or production keys.

# ==============================================================================
# 1. External AI Connectivity (Groq & Google Gemini)
# ==============================================================================
# Groq Cloud API Key (Get from https://console.groq.com)
GROQ_API_KEY=gsk_your_groq_api_key_here
GROQ_MODEL=openai/gpt-oss-120b
GROQ_FALLBACK_MODEL=openai/gpt-oss-20b

# Google Gemini API Key (Get from https://aistudio.google.com)
GEMINI_API_KEY=your_gemini_api_key_here
GOOGLE_API_KEY=

# ==============================================================================
# 2. Server & Security Configuration
# ==============================================================================
SECRET_KEY=generate_a_random_secure_secret_for_production
FLASK_ENV=development
FLASK_PORT=5000
DATABASE_URL=sqlite:///app.db

# Rate limits
AUTH_LOGIN_RATE_LIMIT=120 per minute
AUTH_REGISTER_RATE_LIMIT=120 per minute
AUTH_PASSWORD_RESET_RATE_LIMIT=60 per minute
AI_RATE_LIMIT=200 per minute

# Session & CSRF
WTF_CSRF_ENABLED=False
SESSION_COOKIE_SECURE=False

# CORS Origins (Comma-separated)
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000,http://localhost:5000,http://127.0.0.1:5000

# ==============================================================================
# 3. Transactional Email Service (Resend or Gmail SMTP)
# ==============================================================================
# Set EMAIL_PROVIDER to 'smtp' or 'resend'. Defaults to 'resend' if RESEND_API_KEY is provided, or 'smtp' if SMTP_HOST is set.
EMAIL_PROVIDER=smtp

# --- Option A: Free Gmail SMTP (Works with any recipient without custom domain) ---
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your-email@gmail.com
SMTP_PASSWORD=your-16-char-google-app-password
EMAIL_FROM=SpaceLoop <your-email@gmail.com>

# --- Option B: Resend REST API (Requires verified domain at resend.com for external recipients) ---
# RESEND_API_KEY=re_your_key_here
# EMAIL_FROM=SpaceLoop <onboarding@resend.dev>


