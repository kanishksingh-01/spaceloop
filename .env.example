# ==========================================
# SpaceLoop Production Environment Variables
# ==========================================

# Core Application Settings
FLASK_ENV=production
SECRET_KEY=generate_a_secure_random_64_char_hex_string_here
PORT=5000

# Database Persistence
# For SQLite (default development):
DATABASE_URL=sqlite:///app.db
# For PostgreSQL (Render / Supabase / AWS RDS):
# DATABASE_URL=postgresql://spaceloop_user:your_password@ep-host.render.com/spaceloop_db

# External AI Service Keys (Multi-Tier Failover)
# Tier 1 (Primary): Groq Cloud Ultra-Low Latency Inference
GROQ_API_KEY=gsk_your_groq_api_key_here

# Tier 2 (Multimodal / Fallback): Google Gemini Pro & Vision
GEMINI_API_KEY=your_google_gemini_api_key_here
# GOOGLE_API_KEY=your_google_gemini_api_key_here (alternative alias)

# Note: If external AI keys are omitted, SpaceLoop automatically activates
# its Tier 3 deterministic rule-based and keyword scoring fallback engine.
