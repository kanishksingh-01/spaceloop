{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "rewrites": [
    {
      "source": "/api",
      "destination": "/api/index.py?__path__=/api/health"
    },
    {
      "source": "/api/(.*)",
      "destination": "/api/index.py?__path__=/api/$1"
    },
    {
      "source": "/auth/(.*)",
      "destination": "/api/index.py?__path__=/auth/$1"
    },
    {
      "source": "/switch-(.*)",
      "destination": "/api/index.py?__path__=/switch-$1"
    },
    {
      "source": "/space/:id/printable-qr",
      "destination": "/api/index.py?__path__=/space/:id/printable-qr"
    },
    {
      "source": "/((?!api/|assets/|static/|favicon.ico|robots.txt).*)",
      "destination": "/index.html"
    }
  ]
}
