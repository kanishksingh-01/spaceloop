{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "rewrites": [
    {
      "source": "/api",
      "destination": "https://spaceloop.onrender.com/api/health"
    },
    {
      "source": "/api/(.*)",
      "destination": "https://spaceloop.onrender.com/api/$1"
    },
    {
      "source": "/auth/(.*)",
      "destination": "https://spaceloop.onrender.com/auth/$1"
    },
    {
      "source": "/switch-(.*)",
      "destination": "https://spaceloop.onrender.com/switch-$1"
    },
    {
      "source": "/space/:id/printable-qr",
      "destination": "https://spaceloop.onrender.com/space/:id/printable-qr"
    },
    {
      "source": "/((?!api/|assets/|static/|favicon.ico|robots.txt).*)",
      "destination": "/index.html"
    }
  ]
}
