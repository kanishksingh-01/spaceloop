{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "rewrites": [
    {
      "source": "/api",
      "destination": "/api/index.py?_vercel_path=/api"
    },
    {
      "source": "/api/(.*)",
      "destination": "/api/index.py?_vercel_path=/api/$1"
    },
    {
      "source": "/auth",
      "destination": "/api/index.py?_vercel_path=/auth"
    },
    {
      "source": "/auth/(.*)",
      "destination": "/api/index.py?_vercel_path=/auth/$1"
    },
    {
      "source": "/switch-(.*)",
      "destination": "/api/index.py?_vercel_path=/switch-$1"
    },
    {
      "source": "/space/:id/printable-qr",
      "destination": "/api/index.py?_vercel_path=/space/:id/printable-qr"
    },
    {
      "source": "/static/(.*)",
      "destination": "/api/index.py?_vercel_path=/static/$1"
    },
    {
      "source": "/(.*)",
      "destination": "/index.html"
    }
  ]
}
