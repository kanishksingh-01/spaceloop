# ==============================================================================
# NIRIKSHAK Environment Configuration Template (Trimmed 7-Day MVP)
# ==============================================================================

# Application Environment
ENVIRONMENT=development
DEBUG=true
LOG_LEVEL=info
APP_NAME=NIRIKSHAK
APP_VERSION=0.1.0-mvp

# API Server Configuration
BACKEND_HOST=0.0.0.0
BACKEND_PORT=8000
API_PREFIX=/api/v1
CORS_ORIGINS=["http://localhost:3000","http://127.0.0.1:3000"]

# Seeded Demo Authentication
# Seeded accounts: analyst_sarah / analyst123, admin_vikram / admin123
SECRET_KEY=dev_insecure_secret_key_change_in_production_32bytesmin
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# Primary Database (PostgreSQL) - Holds all state in MVP
POSTGRES_USER=nirikshak
POSTGRES_PASSWORD=nirikshak_dev_pass
POSTGRES_DB=nirikshak
POSTGRES_HOST=db
POSTGRES_PORT=5432
DATABASE_URL=postgresql+asyncpg://nirikshak:nirikshak_dev_pass@db:5432/nirikshak
DATABASE_SYNC_URL=postgresql+psycopg://nirikshak:nirikshak_dev_pass@db:5432/nirikshak

# Deterministic Risk Scoring Policy Weights (Sum to 1.0)
WEIGHT_IDENTITY=0.25
WEIGHT_DEVICE=0.25
WEIGHT_SENSITIVITY=0.25
WEIGHT_BEHAVIOR=0.25

# Risk Classification Thresholds (0-100 scale)
RISK_THRESHOLD_MODERATE=31
RISK_THRESHOLD_HIGH=61
RISK_THRESHOLD_CRITICAL=81

# Frontend Configuration
NEXT_PUBLIC_API_URL=http://localhost:8000/api/v1
NEXT_PUBLIC_APP_NAME=NIRIKSHAK
